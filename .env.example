# Edge GEX Lab settings. Copy this file to .env (setup.bat does it) and fill in what you use.
# .env is never committed.

# Alpaca market data keys (free plan works). Needed for SPY, QQQ and stocks; SPX and NDX work without them.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# paper (default) or live: which Alpaca account the keys belong to. Market data is the same.
ALPACA_MODE=paper
